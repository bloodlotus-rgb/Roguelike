    "ecology:trophic": "node scripts/trophic-report.ts",
    "ecology:dispersal": "node scripts/dispersal-report.ts",
    "ecology:web": "node scripts/food-web-report.ts",
    "ecology:web-load": "node scripts/food-web-load.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
